{
  "name": "@leanprint/work",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "leanprint": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "commander": "^14.0.0",
    "glob": "^11.0.3",
    "leanprint": "workspace:*",
    "tiktoken": "^1.0.22"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  },
  "engines": {
    "node": ">=24"
  }
}
