{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/5cover/leanprint/main/packages/work/src/schemas/GeneratedConfig.json",
  "title": "GeneratedConfig",
  "allOf": [
    {
      "$ref": "./SourceConfig.json#/$defs/config"
    },
    {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "state",
            "toolVersion",
            "sourceRoot",
            "leandir",
            "configFilename",
            "createdAt",
            "configHash",
            "resolvedConfigHash",
            "files",
            "integrity"
          ],
          "properties": {
            "schemaVersion": { "const": 1 },
            "state": { "type": "string", "enum": ["active", "applying", "synchronized"] },
            "toolVersion": { "type": "string" },
            "sourceRoot": { "type": "string" },
            "leandir": { "type": "string" },
            "configFilename": { "type": "string" },
            "createdAt": { "type": "string" },
            "configHash": { "type": "string" },
            "resolvedConfigHash": { "type": "string" },
            "integrity": { "type": "string" },
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source", "lean", "transformed"],
                "properties": {
                  "source": { "$ref": "#/$defs/entry" },
                  "lean": { "$ref": "#/$defs/entry" },
                  "transformed": { "type": "boolean" }
                }
              }
            }
          }
        }
      },
      "required": ["workspace"]
    }
  ],
  "$defs": {
    "entry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "hash", "mode"],
          "properties": {
            "kind": { "const": "file" },
            "hash": { "type": "string" },
            "mode": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "mode"],
          "properties": {
            "kind": { "const": "symlink" },
            "target": { "type": "string" },
            "mode": { "type": "integer" }
          }
        }
      ]
    }
  }
}
